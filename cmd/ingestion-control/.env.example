# Required: shared control-plane Postgres used by ingestion-control and workers.
PERSISTENCE_DSN=postgres://filament:filament@localhost:5432/filament?sslmode=disable

# Required: NATS server with JetStream enabled.
NATS_URL=nats://localhost:4222

# Optional: HTTP listen address for the ConnectRPC API.
INGESTION_ADDR=:8080

# Optional: JetStream stream settings. Defaults match the eventbus package.
NATS_STREAM=EVENTBUS
NATS_SUBJECTS=ingestion.v1.>

# Optional: run datastore migrations on startup. Default is true.
PERSISTENCE_MIGRATE=true

# Optional: tenant row to ensure on startup for POC jobs. Default is t1.
DEFAULT_TENANT_ID=t1
