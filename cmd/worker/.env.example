# Required: run id already persisted by ingestion-control/orchestrator.
RUN_ID=run_replace_me

# Required: same control-plane Postgres used by ingestion-control.
PERSISTENCE_DSN=postgres://filament:filament@localhost:5432/filament?sslmode=disable

# Required: same NATS server used by ingestion-control.
NATS_URL=nats://localhost:4222

# Optional: JetStream stream settings. Defaults match the eventbus package.
NATS_STREAM=EVENTBUS
NATS_SUBJECTS=ingestion.v1.>

# Temporary POC ConfigRef path:
# secret/env maps refs by uppercasing and replacing "-", "/", "." with "_".
# A run Source.ConfigRef of "t1/src-postgres" resolves from T1_SRC_POSTGRES.
# A run Sink.ConfigRef of "t1/sink-postgres" resolves from T1_SINK_POSTGRES.
#
# Values are JSON connector configs. Eventually this will get changed to be 
# an actual secret store fetch but that day is not today.
T1_SRC_POSTGRES={"dsn":"postgres://source:source@localhost:5433/source?sslmode=disable","schema":"public"}
T1_SINK_POSTGRES={"dsn":"postgres://sink:sink@localhost:5434/sink?sslmode=disable","schema":"public"}
