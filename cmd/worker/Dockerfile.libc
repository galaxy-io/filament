# syntax=docker/dockerfile:1
ARG DUCKDB_VERSION=v1.4.1

FROM golang:1.26.10-trixie AS build
ARG VERSION=dev
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    cd cmd/worker && GOWORK=off CGO_ENABLED=1 go build -buildvcs=false -trimpath \
      -ldflags="-s -w -X github.com/galaxy-io/filament/version.Version=${VERSION}" -o /out/worker .

FROM debian:13-slim AS extensions
ARG DUCKDB_VERSION
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip && \
    curl -fsSL -o /tmp/duckdb.zip "https://github.com/duckdb/duckdb/releases/download/${DUCKDB_VERSION}/duckdb_cli-linux-${TARGETARCH}.zip" && \
    unzip -q /tmp/duckdb.zip -d /usr/local/bin && \
    mkdir -p /extensions && HOME=/extensions duckdb -c "INSTALL motherduck; LOAD motherduck;"

FROM gcr.io/distroless/cc-debian13:nonroot

COPY --from=extensions --chown=65532:65532 /extensions/.duckdb /home/nonroot/.duckdb
COPY --from=build /out/worker /app

ENV HOME=/home/nonroot
USER 65532:65532

ENTRYPOINT ["/app"]
