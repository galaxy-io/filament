{
  "name": "@galaxy-io/filament-ts",
  "version": "0.1.0",
  "description": "Generated TypeScript client for the Filament API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxy-io/filament.git",
    "directory": "sdks/typescript"
  },
  "bugs": "https://github.com/galaxy-io/filament/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  }
}
