{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTTP Connector Manifest v1",
  "type": "object",
  "required": ["version", "name", "display_name", "description", "dark_logo_url", "light_logo_url", "connection", "resources"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "dark_logo_url": { "type": "string", "format": "uri" },
    "light_logo_url": { "type": "string", "format": "uri" },
    "api_version": { "type": "string", "minLength": 1 },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["string", "int", "bool", "duration", "enum", "object", "secret", "list"] },
          "required": { "type": "boolean" },
          "default": {},
          "enum": { "type": "array", "items": { "type": "string" } },
          "help": { "type": "string" },
          "scope": { "type": "string", "enum": ["connection", "pipeline", ""] },
          "visible_when": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "values"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
            }
          },
          "enum_labels": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "list" } },
              "required": ["type"]
            },
            "then": {
              "required": ["enum"],
              "properties": {
                "enum": { "minItems": 1, "uniqueItems": true },
                "default": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              }
            }
          }
        ]
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", ""] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "response": { "$ref": "#/$defs/response" },
        "pagination": { "$ref": "#/$defs/pagination" }
      }
    },
    "field_sets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fields"
      }
    },
    "connection": {
      "type": "object",
      "required": ["base_url"],
      "additionalProperties": false,
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_second": { "type": "number", "minimum": 0 },
            "burst": { "type": "integer", "minimum": 1 },
            "responses": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "dependentRequired": {
                  "header_value": ["header"],
                  "body_path": ["body_contains"],
                  "body_contains": ["body_path"]
                },
                "properties": {
                  "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                  "header": { "type": "string", "minLength": 1 },
                  "header_value": { "type": "string", "minLength": 1 },
                  "body_path": { "type": "string", "minLength": 1 },
                  "body_contains": { "type": "string", "minLength": 1 },
                  "backoff_seconds": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "dynamic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "remaining_header": { "type": "string" },
                "reset_header": { "type": "string" },
                "reset_format": { "type": "string", "enum": ["unix_seconds", "seconds_from_now", "http_date"] },
                "min_floor_rps": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "discovery": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["static", "dynamic"] },
        "include": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "default_resources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "map"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "map": {
                "type": "object",
                "required": ["kind", "id"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string" },
                  "name_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "parent_id": { "type": "string" },
                  "default_enabled": { "type": "string" },
                  "group_path": { "type": "string" },
                  "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
                }
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "field": { "type": "string" },
                  "inject_into": { "type": "string", "enum": ["query", "body", "header"] },
                  "applies_to": { "type": "array", "items": { "type": "string" } },
                  "fan_out": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wait", "result"],
      "oneOf": [
        {
          "required": ["start"],
          "properties": {
            "direct": { "const": false }
          }
        },
        {
          "required": ["direct"],
          "properties": {
            "direct": { "const": true }
          },
          "not": { "required": ["start"] }
        }
      ],
      "properties": {
        "direct": { "type": "boolean" },
        "locate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "capture"],
          "properties": {
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "path"],
              "properties": {
                "method": { "type": "string", "enum": ["GET"] },
                "path": { "type": "string", "minLength": 1 },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "query": { "type": "object", "additionalProperties": { "type": "string" } }
              }
            },
            "capture": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["regex"],
                "properties": { "regex": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        "parent_key": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "capture"],
          "properties": {
            "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", ""] },
            "path": { "type": "string", "minLength": 1 },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "query": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "encoding": { "type": "string", "enum": ["json", "form", "multipart", "raw", "none", ""] },
                "template": {}
              }
            },
            "capture": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
          }
        },
        "wait": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "interval_seconds", "timeout_seconds"],
          "properties": {
            "type": { "type": "string", "enum": ["job", "download"] },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "path"],
              "properties": {
                "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", ""] },
                "path": { "type": "string", "minLength": 1 },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "query": { "type": "object", "additionalProperties": { "type": "string" } },
                "body": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "encoding": { "type": "string", "enum": ["json", "form", "multipart", "raw", "none", ""] },
                    "template": {}
                  }
                }
              }
            },
            "state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "pending", "ready"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "pending": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                "ready": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                "failed": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
              }
            },
            "capture": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
            "pending_statuses": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "uniqueItems": true },
            "interval_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "format"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "auth": { "type": "string", "enum": ["none", "connection"] },
            "allowed_hosts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
            "compression": { "type": "string", "enum": ["none", "gzip"] },
            "archive": { "type": "string", "enum": ["none", "zip", "tar"] },
            "files": { "type": "string", "minLength": 1 },
            "format": { "type": "string", "enum": ["json", "ndjson", "csv"] },
            "records_path": { "type": "string", "minLength": 1 },
            "envelope": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status_path", "body_path", "success"],
              "properties": {
                "status_path": { "type": "string", "minLength": 1 },
                "body_path": { "type": "string", "minLength": 1 },
                "success": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "uniqueItems": true },
                "records_path": { "type": "string", "minLength": 1 }
              }
            },
            "csv": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "delimiter": { "type": "string", "minLength": 1 },
                "header": { "type": "boolean" },
                "columns": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
                "quoting": { "type": "string", "enum": ["standard", "none"] }
              }
            },
            "max_download_bytes": { "type": "integer", "minimum": 1 },
            "max_uncompressed_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "next": {
          "type": "object",
          "additionalProperties": false,
          "required": ["more_path", "cursor_path", "request"],
          "properties": {
            "more_path": { "type": "string", "minLength": 1 },
            "cursor_path": { "type": "string", "minLength": 1 },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "path"],
              "properties": {
                "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", ""] },
                "path": { "type": "string", "minLength": 1 },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "query": { "type": "object", "additionalProperties": { "type": "string" } },
                "body": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "encoding": { "type": "string", "enum": ["json", "form", "multipart", "raw", "none", ""] },
                    "template": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": ["name"],
      "anyOf": [
        { "required": ["path"] },
        {
          "required": ["export"],
          "properties": {
            "mode": { "const": "export" }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "export": { "$ref": "#/$defs/export" },
        "emit_as": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", ""] },
        "mode": { "type": "string", "enum": ["paginated", "stream", "export", ""] },
        "primary_key": { "type": "array", "items": { "type": "string" } },
        "records": { "type": "string", "minLength": 1 },
        "for_each": { "type": "string", "minLength": 1 },
        "fields": {
          "$ref": "#/$defs/fields"
        },
        "use_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exclude_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "params": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "capture": { "type": "object", "additionalProperties": { "type": "string" } },
        "capture_only": { "type": "boolean" },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoding": { "type": "string", "enum": ["json", "form", "multipart", "raw", "none", ""] },
            "template": {}
          }
        },
        "response": { "$ref": "#/$defs/response" },
        "pagination": { "$ref": "#/$defs/pagination" },
        "incremental": {
          "type": "object",
          "required": ["start_param", "inject_into"],
          "oneOf": [{"required": ["cursor_field"]}, {"required": ["response_cursor"]}],
          "additionalProperties": false,
          "properties": {
            "cursor_field": { "type": "string", "minLength": 1 },
            "response_cursor": { "type": "string", "minLength": 1 },
            "start_param": { "type": "string", "minLength": 1 },
            "inject_into": { "type": "string", "enum": ["query", "body", "header"] },
            "initial": { "type": "string" },
            "checkpoint_key": { "type": "string" },
            "comparator": { "type": "string", "enum": ["lex", "numeric", "time"] },
            "overlap_seconds": { "type": "integer", "minimum": 0 },
            "value_prefix": { "type": "string" }
          }
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource": { "type": "string" },
            "concurrency": { "type": "integer", "minimum": 1 },
            "since": { "type": "string", "minLength": 1 }
          }
        },
        "stream": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ndjson", "sse", "chunked_array"] },
            "event_filter": { "type": "string" },
            "array_path": { "type": "string" },
            "max_element_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^(string|bool|int16|int32|int64|float32|float64|decimal|date|time|timestamp|timestamptz|json|uuid)\\??$"
          },
          {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "bool", "int16", "int32", "int64", "float32", "float64", "decimal", "date", "time", "timestamp", "timestamptz", "json", "uuid"] },
              "max_string": { "type": "string", "minLength": 1 },
              "shape": { "type": "object", "additionalProperties": { "type": "string" } },
              "mode": { "type": "string", "enum": ["raw", "remainder", ""] },
              "nullable": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "enum": ["array", "object", ""] },
        "records_path": { "type": "string" },
        "records": { "type": "string", "minLength": 1 },
        "pagination": { "$ref": "#/$defs/pagination" },
        "cardinality": { "type": "string", "enum": ["many", "one", ""] },
        "poll_pending": { "type": "boolean" },
        "empty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "body_path", "body_equals"],
          "properties": {
            "status": { "type": "integer", "minimum": 400, "maximum": 499 },
            "body_path": { "type": "string", "minLength": 1 },
            "body_equals": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "when_present": { "type": "boolean" },
            "message_path": { "type": "string" },
            "code_path": { "type": "string" }
          }
        }
      }
    },
    "pagination": {
      "oneOf": [
        { "const": "none" },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "link": { "type": "string", "minLength": 1 },
            "next_url": { "type": "string", "minLength": 1 },
            "cursor": {
              "type": "object",
              "required": ["response", "request"],
              "additionalProperties": false,
              "properties": {
                "response": { "type": "string", "minLength": 1 },
                "request": { "type": "string", "minLength": 3 },
                "more": { "type": "string" },
                "null_terminates": { "type": "boolean" },
                "strict": { "type": "boolean" }
              }
            },
            "offset": {
              "type": "object",
              "required": ["offset", "limit", "page_size"],
              "additionalProperties": false,
              "properties": {
                "more": { "type": "string", "minLength": 1 },
                "offset": { "type": "string" },
                "limit": { "type": "string" },
                "page_size": { "type": "integer", "minimum": 1 }
              }
            },
            "page": {
              "type": "object",
              "required": ["number", "size", "page_size"],
              "additionalProperties": false,
              "properties": {
                "number": { "type": "string" },
                "size": { "type": "string" },
                "page_size": { "type": "integer", "minimum": 1 },
                "total_pages": { "type": "string" },
                "more": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "auth": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "none": {},
        "bearer": { "type": "string", "minLength": 1 },
        "header": {
          "type": "object",
          "required": ["name", "value"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "basic": {
          "type": "object",
          "required": ["username"],
          "additionalProperties": false,
          "properties": {
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" }
          }
        },
        "oauth2": {
          "type": "object",
          "required": ["token_url", "client_id", "client_secret"],
          "additionalProperties": false,
          "properties": {
            "token_url": { "type": "string", "minLength": 1 },
            "client_id": { "type": "string", "minLength": 1 },
            "client_secret": { "type": "string", "minLength": 1 },
            "scope": { "type": "string" },
            "grant_type": { "enum": ["client_credentials", "refresh_token"] },
            "refresh_token": { "type": "string", "minLength": 1 },
            "header_prefix": { "type": "string", "minLength": 1 },
            "params": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "grant_type": { "const": "refresh_token" }
                },
                "required": ["grant_type"]
              },
              "then": { "required": ["refresh_token"] }
            }
          ]
        },
        "select": {
          "type": "object",
          "required": ["field", "cases"],
          "additionalProperties": false,
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "cases": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "required": ["auth"],
                "additionalProperties": false,
                "properties": {
                  "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "auth": { "$ref": "#/$defs/auth" }
                }
              }
            }
          }
        }
      }
    }
  }
}
