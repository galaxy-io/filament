{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTTP Connector Manifest v2",
  "type": "object",
  "required": ["version", "name", "connection", "resources"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "connection": {
      "type": "object",
      "required": ["base_url"],
      "additionalProperties": false,
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "auth": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["bearer", "header", "query", "basic", "oauth2_cc", "hmac", "chain", "none"]
            }
          }
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_second": { "type": "number", "minimum": 0 },
            "dynamic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "remaining_header": { "type": "string" },
                "reset_header": { "type": "string" },
                "reset_format": { "type": "string", "enum": ["unix_seconds", "seconds_from_now", "http_date"] },
                "min_floor_rps": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    },
    "discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "map"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "map": {
            "type": "object",
            "required": ["kind", "id"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "name_paths": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "parent_id": { "type": "string" },
              "default_enabled": { "type": "string" },
              "group_path": { "type": "string" },
              "metadata": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "inject_into": { "type": "string", "enum": ["query", "body", "header"] },
              "applies_to": {
                "type": "array",
                "items": { "type": "string" }
              },
              "fan_out": { "type": "boolean" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "emit_as": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", ""] },
        "mode": { "type": "string", "enum": ["paginated", "stream", ""] },
        "primary_key": { "type": "array", "items": { "type": "string" } },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "type": { "type": "string", "enum": ["string", "bool", "int16", "int32", "int64", "float32", "float64", "decimal", "date", "time", "timestamp", "timestamptz", "json", "uuid"] },
              "shape": { "type": "object", "additionalProperties": { "type": "string" } },
              "mode": { "type": "string", "enum": ["raw", "remainder", ""] },
              "nullable": { "type": "boolean" }
            }
          }
        },
        "capture": { "type": "object", "additionalProperties": { "type": "string" } },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "encoding": { "type": "string", "enum": ["json", "form", "multipart", "raw", "none", ""] },
            "template": {}
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": { "type": "string", "enum": ["array", "object", ""] },
            "records_path": { "type": "string" },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "when_present": { "type": "boolean" },
                "message_path": { "type": "string" },
                "code_path": { "type": "string" }
              }
            }
          }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["cursor", "offset", "page", "link_header", "next_url", "none", ""] },
            "cursor_path": { "type": "string" },
            "cursor_param": { "type": "string" },
            "inject_into": { "type": "string", "enum": ["body", "query", "header", ""] },
            "has_more_path": { "type": "string" },
            "allow_null_terminates": { "type": "boolean" },
            "offset_param": { "type": "string" },
            "limit_param": { "type": "string" },
            "page_size": { "type": "integer", "minimum": 1 },
            "page_param": { "type": "string" },
            "size_param": { "type": "string" },
            "total_pages_path": { "type": "string" },
            "rel": { "type": "string" },
            "next_url_path": { "type": "string" }
          }
        },
        "incremental": {
          "type": "object",
          "required": ["cursor_field", "start_param", "inject_into"],
          "additionalProperties": false,
          "properties": {
            "cursor_field": { "type": "string" },
            "start_param": { "type": "string" },
            "inject_into": { "type": "string", "enum": ["query", "body", "header"] },
            "initial": { "type": "string" },
            "checkpoint_key": { "type": "string" },
            "comparator": { "type": "string", "enum": ["lex", "numeric", "time"] },
            "overlap_seconds": { "type": "integer", "minimum": 0 }
          }
        },
        "parent": {
          "type": "object",
          "required": ["resource"],
          "additionalProperties": false,
          "properties": {
            "resource": { "type": "string" },
            "concurrency": { "type": "integer", "minimum": 1 }
          }
        },
        "stream": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ndjson", "sse", "chunked_array"] },
            "event_filter": { "type": "string" },
            "array_path": { "type": "string" },
            "max_element_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
