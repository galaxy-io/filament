{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Filament",
  "description": "Change data capture and replication, as a single binary or an embeddable Go library.",
  "colors": {
    "primary": "#005EFF",
    "light": "#005EFF",
    "dark": "#005EFF"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "logo": {
    "light": "/assets/filament-light.svg",
    "dark": "/assets/filament-dark.svg",
    "href": "https://github.com/galaxy-io/filament"
  },
  "favicon": "/assets/favicon.svg",
  "fonts": {
    "family": "ABC Diatype",
    "weight": 400,
    "source": "https://cdn.getgalaxy.io/fonts/Diatype/ABCDiatype-Regular.woff2",
    "format": "woff2",
    "heading": {
      "family": "ABC Diatype",
      "weight": 500,
      "source": "https://cdn.getgalaxy.io/fonts/Diatype/ABCDiatype-Medium.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "github-dark-default"
      }
    }
  },
  "interaction": {
    "drilldown": true
  },
  "search": {
    "prompt": "Search"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "mcp"
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/galaxy-io/filament"
      },
      {
        "label": "Join the Slack community",
        "icon": "slack",
        "href": "https://join.slack.com/t/galaxy-filament/shared_invite/zt-45qln0zg5-9CTvKVXugvh3sEhpD6KzJQ"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/galaxy-io/filament",
      "slack": "https://join.slack.com/t/galaxy-filament/shared_invite/zt-45qln0zg5-9CTvKVXugvh3sEhpD6KzJQ",
      "website": "https://getgalaxy.io"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "thumbnails": {
    "appearance": "dark"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "pages/guides/get-started/introduction",
          "pages/guides/get-started/quickstart",
          "pages/guides/get-started/installation"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "pages/guides/concepts/overview",
          "pages/guides/concepts/architecture",
          "pages/guides/concepts/replication-modes",
          "pages/guides/concepts/integrity-and-checkpoints",
          "pages/guides/concepts/runs-and-recovery"
        ]
      },
      {
        "group": "Usage",
        "pages": [
          "pages/guides/usage/web",
          "pages/guides/usage/cli",
          "pages/guides/usage/embedded"
        ]
      },
      {
        "group": "Connectors",
        "pages": [
          "pages/connectors/overview/introduction",
          {
            "group": "Sources",
            "pages": [
              "pages/connectors/sources/postgres",
              "pages/connectors/sources/mysql",
              "pages/connectors/sources/attio",
              "pages/connectors/sources/github",
              "pages/connectors/sources/linear",
              "pages/connectors/sources/notion",
              "pages/connectors/sources/posthog",
              "pages/connectors/sources/resend",
              "pages/connectors/sources/slack",
              "pages/connectors/sources/stripe",
              "pages/connectors/sources/sample"
            ]
          },
          {
            "group": "Sinks",
            "pages": [
              "pages/connectors/sinks/postgres",
              "pages/connectors/sinks/mysql",
              "pages/connectors/sinks/clickhouse",
              "pages/connectors/sinks/iceberg",
              "pages/connectors/sinks/aws-s3",
              "pages/connectors/sinks/standard-output"
            ]
          },
          {
            "group": "Building a connector",
            "pages": [
              "pages/connectors/building-a-connector/overview",
              "pages/connectors/building-a-connector/writing-a-source",
              "pages/connectors/building-a-connector/writing-a-sink",
              "pages/connectors/building-a-connector/optional-interfaces",
              "pages/connectors/building-a-connector/http-manifests"
            ]
          }
        ]
      },
      {
        "group": "Deployment",
        "pages": [
          "pages/guides/deployment/overview",
          "pages/guides/deployment/configuration",
          "pages/guides/deployment/kubernetes",
          "pages/guides/deployment/railway",
          "pages/guides/deployment/render"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "pages/api-reference/service/introduction",
          "pages/api-reference/service/connectors",
          "pages/api-reference/service/connections",
          "pages/api-reference/service/pipelines",
          "pages/api-reference/service/runs",
          "pages/api-reference/service/metrics"
        ]
      },
      {
        "group": "Benchmarks",
        "pages": [
          "pages/benchmarks/overview"
        ]
      },
      {
        "group": "Contributing",
        "pages": [
          "pages/guides/contributing/local-development",
          "pages/guides/contributing/style-and-testing"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/pages/guides/get-started/introduction"
    },
    {
      "source": "/pages/connectors/sources/http",
      "destination": "/pages/connectors/building-a-connector/http-manifests"
    },
    {
      "source": "/pages/benchmarks/methodology/introduction",
      "destination": "/pages/benchmarks/overview"
    },
    {
      "source": "/pages/benchmarks/pipeline/throughput",
      "destination": "/pages/benchmarks/overview"
    },
    {
      "source": "/pages/benchmarks/event-bus/publish-overhead",
      "destination": "/pages/benchmarks/overview"
    },
    {
      "source": "/pages/guides/ui/pipelines-and-canvas",
      "destination": "/pages/guides/usage/web"
    },
    {
      "source": "/pages/guides/ui/overview",
      "destination": "/pages/guides/usage/web"
    },
    {
      "source": "/pages/guides/ui/connections",
      "destination": "/pages/guides/usage/web"
    },
    {
      "source": "/pages/guides/ui/pipelines",
      "destination": "/pages/guides/usage/web"
    },
    {
      "source": "/pages/guides/get-started/web",
      "destination": "/pages/guides/usage/web"
    },
    {
      "source": "/pages/guides/get-started/cli",
      "destination": "/pages/guides/usage/cli"
    },
    {
      "source": "/pages/connectors/sinks/stdout",
      "destination": "/pages/connectors/sinks/standard-output"
    }
  ]
}
