{
  "name": "@galaxy-io/filament",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./paths": {
      "types": "./dist/module/paths.d.ts",
      "import": "./dist/module/paths.js"
    },
    "./routes": {
      "types": "./dist/module/routes.d.ts",
      "import": "./dist/module/routes.js"
    },
    "./FilamentLayout": {
      "types": "./dist/module/FilamentLayout.d.ts",
      "import": "./dist/module/FilamentLayout.js"
    },
    "./pages/NotFoundPage": {
      "types": "./dist/pages/NotFoundPage.d.ts",
      "import": "./dist/pages/NotFoundPage.js"
    },
    "./pages/ObservabilityPage": {
      "types": "./dist/pages/observability/ObservabilityPage.d.ts",
      "import": "./dist/pages/observability/ObservabilityPage.js"
    },
    "./pages/PipelinesPage": {
      "types": "./dist/pages/pipelines/PipelinesPage.d.ts",
      "import": "./dist/pages/pipelines/PipelinesPage.js"
    },
    "./pages/PipelinePage": {
      "types": "./dist/pages/pipelines/PipelinePage.d.ts",
      "import": "./dist/pages/pipelines/PipelinePage.js"
    },
    "./pages/PipelineCanvasPage": {
      "types": "./dist/pages/pipelines/PipelineCanvasPage.d.ts",
      "import": "./dist/pages/pipelines/PipelineCanvasPage.js"
    },
    "./pages/PipelineHistoryPage": {
      "types": "./dist/pages/pipelines/PipelineHistoryPage.d.ts",
      "import": "./dist/pages/pipelines/PipelineHistoryPage.js"
    },
    "./pages/PipelineSettingsPage": {
      "types": "./dist/pages/pipelines/PipelineSettingsPage.d.ts",
      "import": "./dist/pages/pipelines/PipelineSettingsPage.js"
    },
    "./pages/SourcesPage": {
      "types": "./dist/pages/connections/SourcesPage.d.ts",
      "import": "./dist/pages/connections/SourcesPage.js"
    },
    "./pages/SinksPage": {
      "types": "./dist/pages/connections/SinksPage.d.ts",
      "import": "./dist/pages/connections/SinksPage.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "codegen": "buf generate",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
    "check:package": "publint --strict && node scripts/check-package.mjs",
    "check:host": "tsc -p fixtures/host/tsconfig.json && vite build --config fixtures/host/vite.config.ts",
    "check": "pnpm typecheck && pnpm typecheck:lib && pnpm lint:check && pnpm format:check && pnpm build && pnpm build:lib && pnpm check:package && pnpm check:host",
    "clean": "rm -rf build dist",
    "format": "biome check --write",
    "format:check": "biome check",
    "lint": "biome lint --write",
    "lint:check": "biome lint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.2",
    "pluralize": "^8.0.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-query": "^2.1.1",
    "@galaxy-io/dls": "^2.10.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@uiw/codemirror-extensions-langs": "^4.25.10",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "cronstrue": "^3.27.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lottie-react": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@bufbuild/buf": "^1.57.2",
    "@bufbuild/protobuf": "^2.9.0",
    "@bufbuild/protoc-gen-es": "^2.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-query": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.0",
    "@galaxy-io/dls": "^2.10.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@tanstack/router-plugin": "^1.141.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@uiw/codemirror-extensions-langs": "^4.25.10",
    "@uiw/codemirror-themes": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^6.0.2",
    "@wyw-in-js/vite": "^1.1.0",
    "cronstrue": "^3.27.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lottie-react": "^2.4.1",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.1.2"
  }
}
